{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "gopls": {
        "type": "local",
        "command": ["gopls", "mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--no-performance-crux",
          "--headless"
        ]
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"]
      }
    }
  }
}
