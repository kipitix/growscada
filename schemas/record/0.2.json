{
  "$defs": {
    "Entry": {
      "properties": {
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "schema_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "tag_state": {
          "$ref": "#/$defs/TagState"
        },
        "timestamp": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "timestamp",
        "project_id",
        "type"
      ],
      "type": "object"
    },
    "Header": {
      "properties": {
        "schema_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "schema_version"
      ],
      "type": "object"
    },
    "Revision": {
      "properties": {
        "cause": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "rolled_back_from": {
          "type": "integer"
        }
      },
      "required": [
        "number",
        "cause"
      ],
      "type": "object"
    },
    "TagState": {
      "properties": {
        "quality": {
          "type": "string"
        },
        "tag_id": {
          "format": "uuid",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "tag_id",
        "value",
        "quality"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/kipitix/growscada/schemas/record/0.2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrowSCADA operational record format 0.2"
}
